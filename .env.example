# Bhoonidhi API Credentials
# Note: Bhoonidhi username should not contain hyphens (-)
BHOONIDHI_USER_ID=your_username_here
BHOONIDHI_PASSWORD=your_password_here

# Bhoonidhi API Endpoints (Defaults)
BHOONIDHI_BASE_URL=https://bhoonidhi-api.nrsc.gov.in
BHOONIDHI_TOKEN_URL=https://bhoonidhi-api.nrsc.gov.in/auth/token
